{
  "name": "country-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:static": "chokidar \"index.html\" \"styles.css\" -c \"node scripts/copy-static.mjs\"",
    "dev:serve": "live-server dist --port=3000 --no-browser",
    "dev": "npm run build && concurrently -n tsc,static,serve -c blue,green,yellow \"npm:dev:tsc\" \"npm:dev:static\" \"npm:dev:serve\""
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "live-server": "^1.2.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
